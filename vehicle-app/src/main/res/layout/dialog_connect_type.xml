<?xml version="1.0" encoding="utf-8"?>
<!--
  "连接方式"弹窗：连接方式 3 选 1 + "记住授权" 单 CheckBox。
  - 颜色策略：
    - 文字用 ?android:attr/textColorPrimary，跟随主题（深色模式白字、浅色模式黑字）
    - 圆圈/方框用 app:buttonTint="@color/purple_500"（紫色固定色），
      不论弹窗背景是深色（车机端）还是浅色（模拟器）都明显可见
  - "记住授权" 仅在选中 USB 时显示，其他连接方式没这个概念。
  - 点击选项只改 UI 状态，由 AlertDialog 的 positive button 触发保存。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <RadioGroup
        android:id="@+id/rg_connect_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rb_usb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            app:buttonTint="@color/teal_200"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/connect_type_usb" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rb_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            app:buttonTint="@color/teal_200"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/connect_type_wifi" />

        <androidx.appcompat.widget.AppCompatRadioButton
            android:id="@+id/rb_direct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            app:buttonTint="@color/teal_200"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/connect_type_direct" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/cl_text_c_btn_dialog" />

    <LinearLayout
        android:id="@+id/ll_remember_grant"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/cb_remember_grant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:buttonTint="@color/teal_200"
            android:textSize="18sp"
            android:textColor="?android:attr/textColorPrimary"
            android:text="@string/connect_type_remember_title" />
    </LinearLayout>
</LinearLayout>
